<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Gambar Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/phone_bg" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Judul (Sudah diberi marginTop 48dp agar tidak tertutup notch kamera) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="Halaman Home"
                android:textColor="@color/black"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="Silahkan pilih..."
                android:textColor="#555555" />

            <!-- Tombol-tombol -->
            <Button
                android:id="@+id/btnSnackBar"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#5C4D9A"
                android:text="Snack Bar" />

            <Button
                android:id="@+id/btnAlertDialog"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#5C4D9A"
                android:text="Alert Dialog" />

            <Button
                android:id="@+id/btnToFifth"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#D81B60"
                android:text="Pertemuan 5" />

            <Button
                android:id="@+id/btnToSixth"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#00897B"
                android:text="Pertemuan 6" />

            <Button
                android:id="@+id/btnToTenth"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#795548"
                android:text="Pertemuan 10" />

            <Button
                android:id="@+id/btnToEleventh"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1976D2"
                android:text="Pertemuan 11" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#E53935"
                android:text="Logout" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>